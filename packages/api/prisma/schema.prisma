// ═══════════════════════════════════════════════════════════════
// Quanta — Prisma Schema
// Multi-role RBAC · Account + BU scoping · Domain-whitelisted auth
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──

enum ProjectStatus {
  active
  on_hold
  complete
  archived
  draft
}

enum PricingModel {
  time_and_materials
  fixed_price
}

enum Role {
  IC
  PM
  AC
  BUL
  AA
}

// Project pricing currency. Rates, fees, and fixed prices on a project are
// denominated in its currency; cross-project aggregations convert at display
// time (services/currency.ts).
// ── Scoped permission grants (overlay on role presets) ──────────────────
// Additive-only: a grant can widen what roles allow, never narrow it.
// scopeId is null only for platform scope ("Everything").
enum Permission {
  view_financials
  view_bill_rates
  manage_projects
  approve_drafts
  manage_users
}

enum GrantScope {
  platform
  business_unit
  account
  project
}

model PermissionGrant {
  id         String     @id @default(uuid())
  userId     String     @map("user_id")
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission
  scopeType  GrantScope @map("scope_type")
  scopeId    String?    @map("scope_id")
  grantedBy  String?    @map("granted_by")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@unique([userId, permission, scopeType, scopeId])
  @@index([userId])
  @@map("permission_grants")
}

enum Currency {
  USD
  GBP
  DKK
  EUR
  CHF
  CAD
}

// ── User ──

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  name            String
  passwordHash    String?   @map("password_hash")     // null until an invited user activates their account
  totpSecret      String?   @map("totp_secret")     // AES-encrypted TOTP secret
  totpVerified    Boolean   @default(false) @map("totp_verified")
  roles           Role[]    @default([IC])
  projectRoles    String[]  @default([]) @map("project_roles")  // e.g. ["iOS Dev", "Backend"]
  primaryBuId     String    @map("primary_bu_id")
  primaryBu       BusinessUnit @relation(fields: [primaryBuId], references: [id])
  financialAccess Boolean   @default(false) @map("financial_access") // for AA users
  costRate        Decimal?  @map("cost_rate") @db.Decimal(10, 2) // standing fully-loaded hourly cost; BUL-maintained, snapshotted onto new assignments
  costRateCurrency Currency @default(USD) @map("cost_rate_currency") // currency of costRate; converted to project currency wherever the default is applied
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  assignments      ResourceAssignment[]
  managedAccounts  AccountManager[]
  projectsCreated  Project[]        @relation("ProjectCreator")
  reviewingProjects ProjectReviewer[] @relation("ProjectReviewerUser")
  reviewerAdds     ProjectReviewer[] @relation("ProjectReviewerAddedBy")
  auditLogs        AuditLog[]       @relation("AuditActor")
  domainsAdded     DomainWhitelist[] @relation("DomainAdder")
  invitesSent      UserInvite[]     @relation("InviteSender")
  passwordResets   PasswordReset[]
  baselinesCaptured PlanBaseline[]  @relation("BaselineCapturer")

  @@index([primaryBuId])
  permissionGrants PermissionGrant[]

  @@map("users")
}

// ── Business Unit ──

model BusinessUnit {
  id        String   @id @default(uuid())
  code      String   @unique                // e.g. "US-ORD-OWLS"
  name      String                          // e.g. "Chicago Owls"
  isActive  Boolean  @default(true) @map("is_active")
  // Margin target (percent, e.g. 35 = 35%) — drives BU-health comparisons and
  // the below-target flag on this BU's projects. Editable by AA and the BU's lead.
  targetMarginPct Float @default(35) @map("target_margin_pct")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  users          User[]
  ownedProjects  Project[]       @relation("ProjectOwningBU")
  sharedProjects ProjectShare[]
  invites        UserInvite[]

  @@map("business_units")
}

// ── Account (Client) ──

model Account {
  id        String   @id @default(uuid())
  name      String                          // e.g. "Meridian Corp"
  code      String   @unique                // e.g. "MER"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  projects  Project[]
  managers  AccountManager[]

  @@map("accounts")
}

// ── Account Manager (join: User <-> Account) ──

model AccountManager {
  id        String  @id @default(uuid())
  accountId String  @map("account_id")
  userId    String  @map("user_id")
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, userId])
  @@index([userId])
  @@map("account_managers")
}

// ── Domain Whitelist ──

model DomainWhitelist {
  id       String   @id @default(uuid())
  domain   String   @unique                 // e.g. "trifork.com"
  addedBy  String   @map("added_by")
  addedAt  DateTime @default(now()) @map("added_at")
  addedByUser User  @relation("DomainAdder", fields: [addedBy], references: [id])

  @@map("domain_whitelist")
}

// ── Project ──

model Project {
  id             String        @id @default(uuid())
  name           String
  accountId      String        @map("account_id")
  account        Account       @relation(fields: [accountId], references: [id])
  owningBuId     String        @map("owning_bu_id")
  owningBu       BusinessUnit  @relation("ProjectOwningBU", fields: [owningBuId], references: [id])
  projectCode    String        @unique @map("project_code")
  startDate      DateTime      @map("start_date") @db.Date
  endDate        DateTime      @map("end_date") @db.Date
  contingencyPct Decimal       @default(0.15) @map("contingency_pct") @db.Decimal(5, 4)
  status         ProjectStatus @default(active)
  pricingModel   PricingModel  @default(time_and_materials) @map("pricing_model")
  currency      Currency     @default(USD)
  fixedPrice     Decimal?      @map("fixed_price") @db.Decimal(12, 2)
  description    String?
  // Draft review feedback: set when an approver rejects a draft (the draft is
  // NOT deleted — it stays a draft so the owner can revise). Cleared on resubmit
  // or approval.
  rejectionNote  String?       @map("rejection_note")
  rejectionAt    DateTime?     @map("rejection_at")
  createdById    String        @map("created_by")
  createdBy      User          @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  // Relations
  assignments ResourceAssignment[]
  shares      ProjectShare[]
  reviewers   ProjectReviewer[]
  baseline    PlanBaseline?

  @@index([accountId, owningBuId, status])
  @@map("projects")
}

// ── Project Share (cross-BU visibility for BULs) ──

model ProjectShare {
  id              String       @id @default(uuid())
  projectId       String       @map("project_id")
  sharedWithBuId  String       @map("shared_with_bu_id")
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sharedWithBu    BusinessUnit @relation(fields: [sharedWithBuId], references: [id])
  createdAt       DateTime     @default(now()) @map("created_at")

  @@unique([projectId, sharedWithBuId])
  @@index([sharedWithBuId])
  @@map("project_shares")
}

/// User-level review invitations on a draft project. Distinct from ProjectShare
/// (which is BU-level): this is "I want these specific colleagues to review my
/// draft". Approval rights are derived from role (see canApproveDraft), not from
/// this table — a reviewer who lacks AA/BUL mandate can look but not approve.
model ProjectReviewer {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  userId     String   @map("user_id")
  addedById  String   @map("added_by")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation("ProjectReviewerUser", fields: [userId], references: [id])
  addedBy    User     @relation("ProjectReviewerAddedBy", fields: [addedById], references: [id])
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_reviewers")
}

// ── Resource Assignment ──

model ResourceAssignment {
  id           String  @id @default(uuid())
  projectId    String  @map("project_id")
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId       String  @map("user_id")
  user         User    @relation(fields: [userId], references: [id])
  projectRole  String  @map("project_role")         // e.g. "iOS Dev", "PM"
  billRate     Decimal? @map("bill_rate") @db.Decimal(10, 2) // null on fixed-price projects (no per-hour billing)
  costRate     Decimal @map("cost_rate") @db.Decimal(10, 2)
  businessUnit String  @map("business_unit")        // user's BU at assignment time
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  hourEntries HourEntry[]

  @@unique([projectId, userId])
  @@map("resource_assignments")
}

// ── Hour Entry ──

model HourEntry {
  id            String             @id @default(uuid())
  assignmentId  String             @map("assignment_id")
  assignment    ResourceAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  projectWeek   Int                @map("project_week")      // 0-based week index
  weekStartDate DateTime           @map("week_start_date") @db.Date
  plannedHours  Decimal?           @map("planned_hours") @db.Decimal(5, 2)
  actualHours   Decimal?           @map("actual_hours") @db.Decimal(5, 2)
  locked        Boolean            @default(false)

  @@unique([assignmentId, projectWeek])
  @@index([assignmentId, projectWeek])
  @@map("hour_entries")
}

// ── Audit Log ──

model AuditLog {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type")            // e.g. "User", "HourEntry", "Project"
  entityId   String   @map("entity_id")
  field      String                                   // e.g. "roles", "actual_hours", "cost_rate"
  oldValue   String?  @map("old_value")
  newValue   String?  @map("new_value")
  changedBy  String   @map("changed_by")
  changedByUser User  @relation("AuditActor", fields: [changedBy], references: [id])
  changedAt  DateTime @default(now()) @map("changed_at")

  @@index([entityType, entityId, changedAt])
  @@map("audit_logs")
}

// ── Global Config ──

model GlobalConfig {
  key   String @id
  value String

  @@map("global_config")
}

// ── User Invitation ──

model UserInvite {
  id            String       @id @default(uuid())
  token         String       @unique                                      // URL-safe random token
  email         String                                                    // invitee email
  name          String?                                                   // optional name pre-fill
  buId          String       @map("bu_id")                                // BU the new user will belong to
  bu            BusinessUnit @relation(fields: [buId], references: [id])
  projectRole   String?      @map("project_role")                         // optional hint for the invitee
  roles         Role[]       @default([IC])                                // system roles the invitee receives on accept
  invitedBy     String       @map("invited_by")
  invitedByUser User         @relation("InviteSender", fields: [invitedBy], references: [id])
  expiresAt     DateTime     @map("expires_at")
  acceptedAt    DateTime?    @map("accepted_at")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([email])
  @@index([expiresAt])
  @@map("user_invites")
}

/// Password-reset tokens. A user requesting a reset gets a short-lived,
/// single-use token; resetting consumes it (usedAt set) and any other
/// outstanding tokens for that user are cleared. Tokens are random and
/// URL-safe; matching the invite pattern they're stored raw with a short
/// expiry (hashing-at-rest is a hardening follow-up).
model PasswordReset {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_resets")
}

/// Frozen snapshot of a project's plan, captured when the project first goes
/// active ("Initial Plan"). One per project, immutable. The live assignments +
/// hour entries remain the editable "Current Plan"; actuals accrue against them.
/// Stored as JSON because it is read as a whole for plan-vs-actuals comparison.
model PlanBaseline {
  id           String   @id @default(uuid())
  projectId    String   @unique @map("project_id")
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  capturedAt   DateTime @default(now()) @map("captured_at")
  capturedById String   @map("captured_by")
  capturedBy   User     @relation("BaselineCapturer", fields: [capturedById], references: [id])
  snapshot     Json

  @@map("plan_baselines")
}
