# Nginx config for the Quanta web container.
#
# Two behaviours:
#   1) /api/* requests are reverse-proxied to the API container. On Fly
#      this is the internal address quanta-api.internal:4000 — traffic
#      stays inside the Fly private network so the SPA-to-API hop never
#      crosses the public internet, and the user sees a single origin
#      (no CORS).
#   2) Everything else is served from the static dist/ folder. Unknown
#      paths fall back to index.html so React Router's client-side
#      routes work on direct-link / refresh.
#
# `${API_INTERNAL_URL}` is templated at container startup via envsubst
# in docker-entrypoint.sh, so the same image works for staging, prod,
# and any local-compose setup just by changing the env var.

server {
    listen 8080 default_server;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Disable nginx version disclosure in error responses + the
    # Server header.
    server_tokens off;

    # Browsers should never cache index.html — we want them to pick up
    # new builds on every page load. Hashed assets are safe to cache
    # aggressively.
    location = /index.html {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        try_files $uri =404;
    }

    location /assets/ {
        # Vite writes content-hashed filenames into /assets, so these
        # can be cached forever.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location /api/ {
        # Resolve the API host at REQUEST time, not at nginx startup. With a
        # literal hostname in proxy_pass, nginx resolves quanta-api.internal
        # once when it boots and FAILS TO START ("host not found in upstream")
        # if it isn't resolvable yet — e.g. the API is mid-deploy — which takes
        # the entire web app down (every request, including the SPA, 502s).
        # Fly's internal DNS resolver is fdaa::3; using it plus a variable in
        # proxy_pass makes nginx start regardless and re-resolve per request,
        # so it also picks up the API's new address whenever it redeploys.
        resolver           [fdaa::3] valid=10s;
        set $api_upstream  "${API_INTERNAL_URL}";
        proxy_pass         $api_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   X-Forwarded-Host  $host;

        # The API streams export.pdf and export.csv responses; allow
        # longer timeouts so big projects can render to completion.
        proxy_connect_timeout 30s;
        proxy_send_timeout    60s;
        proxy_read_timeout    60s;

        # The API's own 4xx/5xx responses (e.g. 401 on bad credentials, 500
        # on an app bug) must reach the SPA unchanged, so proxy_intercept_errors
        # is left off (the default). Only the errors nginx ITSELF raises when it
        # can't reach the API at all (connection refused, DNS failure, timeout)
        # are caught here — and we answer with JSON, not the SPA's index.html.
        # Serving the HTML shell for a dead backend is exactly what made an
        # unreachable API look like a generic 502 page during bring-up; an /api
        # client should always get a machine-readable body.
        error_page 502 503 504 = @api_unavailable;

        # Cookies are first-party (same origin as the SPA), so we don't
        # need to rewrite Set-Cookie domain — the API can issue cookies
        # for the web hostname and they Just Work.
    }

    # Clean JSON error for /api/* when the API container is unreachable.
    location @api_unavailable {
        default_type application/json;
        return 502 '{"error":"API temporarily unavailable"}';
    }

    # SPA fallback: any unmatched non-API path serves index.html so
    # /projects/123, /admin, etc. work on direct navigation.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # SPA client-side routing only: a missing *page* serves index.html so
    # deep links survive a refresh. 5xx is handled per-location (see /api/) —
    # a server error should never be answered with the SPA shell.
    error_page 404 /index.html;
}
