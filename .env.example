# ═══════════════════════════════════════════
# Quanta — Environment Variables
# Copy to .env and fill in real values
# ═══════════════════════════════════════════

# ── Database ──
DATABASE_URL=postgresql://quanta:quanta@localhost:5432/quanta?schema=public

# ── Redis ──
REDIS_URL=redis://localhost:6379

# ── Session ──
SESSION_SECRET=replace-with-a-64-char-random-string

# ── TOTP / MFA ──
TOTP_ENCRYPTION_KEY=replace-with-a-32-char-hex-key

# ── Email (AWS SES or SMTP) ──
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@quanta.app

# ── App ──
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
NODE_ENV=development

# ── AWS (production only) ──
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=quanta-exports
